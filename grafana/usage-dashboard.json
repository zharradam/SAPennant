{
  "title": "SA Pennant — Usage & Health",
  "uid": "sapennant-usage",
  "tags": ["sapennant"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki data source",
        "type": "datasource",
        "query": "loki",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Distinct visitors",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (visitor) (count_over_time({app=\"sapennant-api\", category=\"usage\"} | json | visitor != `` [$__range])))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Visits",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=\"sapennant-api\", category=\"usage\"} | json | Event = `visit` [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "New visitors",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=\"sapennant-api\", category=\"usage\"} |= `(first visit)` [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=\"sapennant-api\", level=\"error\"} [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Visits — new vs returning vs reloads",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=\"sapennant-api\", category=\"usage\"} |= `(first visit)` [$__auto]))",
          "legendFormat": "New visitors"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({app=\"sapennant-api\", category=\"usage\"} |= `(return)` [$__auto]))",
          "legendFormat": "Returning"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({app=\"sapennant-api\", category=\"usage\"} |= `(reload)` [$__auto]))",
          "legendFormat": "Reloads"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Tab views",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (Data) (count_over_time({app=\"sapennant-api\", category=\"usage\"} | json | Event = `tab` [$__range])))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{Data}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Searches & lookups (search, player, club, handicap, share)",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 16, "x": 8, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"sapennant-api\", category=\"usage\"} | json | Event =~ `search|player|club|handicap|share`"
        }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "dedupStrategy": "none", "enableLogDetails": true }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Live activity feed",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"sapennant-api\", category=\"usage\"}"
        }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "dedupStrategy": "none", "enableLogDetails": true }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Errors over time",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({app=\"sapennant-api\", level=\"error\"} [$__auto]))",
          "legendFormat": "Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60 },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Recent errors",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 31 },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"sapennant-api\", level=\"error\"}"
        }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "dedupStrategy": "none", "enableLogDetails": true }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Sync activity",
      "datasource": { "type": "loki", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 39 },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"sapennant-api\", category=\"sync\"}"
        }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "dedupStrategy": "none", "enableLogDetails": true }
    }
  ]
}
